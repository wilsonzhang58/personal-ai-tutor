# Copy to backend/.env. Never commit the filled file.
# Demo: no OpenAI key, no paid model calls. E5 weights download on first retrieval.
TUTOR_DEMO_MODE=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Optional OpenAI-compatible provider endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional SQLite location; relative paths resolve from the repository root.
# Parent directories and the default data/tutor.db are created automatically.
# TUTOR_DB_URL=sqlite:///./data/tutor.db
TUTOR_TIMEZONE=Asia/Hong_Kong
# Concept matching uses local IDs/aliases/cache/E5; no dedicated paid matching call.
# This policy is fixed in code, not an environment switch.

# Optional frontend process setting (not read from backend/.env):
# TUTOR_BACKEND_URL=http://127.0.0.1:8000
