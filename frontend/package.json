    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
